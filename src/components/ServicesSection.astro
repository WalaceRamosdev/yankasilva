---
import { Palette, Layers, Sparkles, Share2, FileBox } from "lucide-react";

const services = [
  {
    title: "Logotipo",
    desc: "Criação de símbolos memoráveis que resumem o DNA da sua marca em segundos.",
    icon: Palette,
  },
  {
    title: "Identidade Visual",
    desc: "Sistemas visuais completos que garantem consistência e profissionalismo em todos os pontos.",
    icon: Layers,
  },
  {
    title: "Branding",
    desc: "Construção de percepção de valor e autoridade através de design estratégico.",
    icon: Sparkles,
  },
  {
    title: "Social Media",
    desc: "Design focado em converter seguidores em clientes através de conteúdo visual de alto nível.",
    icon: Share2,
  },
  {
    title: "Materiais Gráficos",
    desc: "Papelaria e itens digitais que elevam a experiência do seu cliente com a marca.",
    icon: FileBox,
  },
];
---

<section id="servicos" class="bg-[#050505] py-24 px-6 overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-20 reveal">
      <h2 class="text-4xl md:text-6xl font-bold text-white mb-6">
        Soluções Estratégicas
      </h2>
      <p
        class="text-white/40 text-lg md:text-xl max-w-2xl mx-auto font-light leading-relaxed"
      >
        Elevamos sua marca através de design focado em resultados e
        posicionamento de mercado.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        services.map((service) => {
          const ServiceIcon = service.icon;
          return (
            <div class="reveal group relative bg-[#0A0A0A] border border-white/5 p-10 rounded-[2.5rem] transition-all duration-500 hover:bg-[#0D0D0D] hover:border-primary/20 cursor-default">
              <div class="mb-8 inline-flex p-4 rounded-2xl bg-primary/10 text-primary transition-transform duration-500 group-hover:scale-110 group-hover:bg-primary group-hover:text-white">
                <ServiceIcon size={28} strokeWidth={1.5} />
              </div>

              <h3 class="text-2xl font-bold text-white mb-4 group-hover:text-primary transition-colors">
                {service.title}
              </h3>

              <p class="text-white/40 text-base leading-relaxed font-light group-hover:text-white/60 transition-colors">
                {service.desc}
              </p>

              {/* Detalhe sutil */}
              <div class="absolute top-0 right-0 p-8 opacity-0 group-hover:opacity-10 transition-opacity">
                <ServiceIcon size={80} strokeWidth={0.5} />
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  function reveal() {
    const reveals = document.querySelectorAll(".reveal");
    reveals.forEach((reveal) => {
      const windowHeight = window.innerHeight;
      const elementTop = reveal.getBoundingClientRect().top;
      const elementVisible = 100;
      if (elementTop < windowHeight - elementVisible) {
        reveal.classList.add("active");
      }
    });
  }
  window.addEventListener("scroll", reveal);
  window.addEventListener("DOMContentLoaded", reveal);
</script>
